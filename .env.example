RELAYIT_DB_PATH=relayit.db
RELAYIT_CONFIDENCE_THRESHOLD=0.62
# Optional Semantic Kernel provider. Leave blank for honest deterministic demo mode.
RELAYIT_MODEL_PROVIDER=deterministic
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
# JSON map of username to PBKDF2 password hash and role. Generate a hash with:
# python -m relayit.auth
# Example shape (do not use these credentials):
# RELAYIT_AUTH_USERS_JSON={"reviewer":{"password_hash":"<generated-hash>","role":"reviewer"}}
RELAYIT_AUTH_USERS_JSON=
